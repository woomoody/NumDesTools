  "mcp": {
    "FeishuProjectMcp": {
      "type": "remote",
      "url": "https://project.feishu.cn/mcp_server/v1",
      "headers": {
        "Authorization": "Bearer m-002580b6-b3db-405a-aab8-007f927ef4eb"
      },
      "enabled": true
    },
    "unity-mcp": {
      "type": "remote",
      "url": "http://localhost:8080/mcp",
      "enabled": true
    },
    "windows-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.14",
        "windows-mcp",
        "serve"
      ],
      "enabled": true
    },
    "wpf-visual-tree": {
      "type": "local",
      "command": [
        "C:\\Users\\cent\\Documents\\NumDesOutput\\tools\\WpfVisualTreeMcp\\server\\WpfVisualTreeMcp.Server.exe"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "dotnet *": "allow",
      "python *": "allow",
      "pwsh *": "allow",
      "ssh *": "allow",
      "uvx *": "allow",
