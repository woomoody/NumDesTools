    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "external_directory": {
      "C:\\Users\\cent\\**": "allow",
      "C:\\Pro\\**": "allow",
      "C:\\M1Work\\**": "allow",
      "C:\\tmp\\**": "allow",
      "*": "allow"
    }
