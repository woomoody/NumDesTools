<ui:FluentWindow x:Class="NumDesTools.FileLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="文件占用" Height="300" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowBackdropType="None"
        Background="#1E1E1E"
        KeyDown="Window_KeyDown">
    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0" Text="文件正被占用，无法保存：" FontWeight="Bold" Margin="0,4,0,8" />

        <ui:TextBox Grid.Row="1" x:Name="FilePathBox" IsReadOnly="True"
                     TextWrapping="Wrap" Margin="0,0,0,8" />

        <ui:Card Grid.Row="2" Margin="0,0,0,12" Padding="8">
            <ui:Card.Content>
                <StackPanel>
                    <ui:TextBlock Text="占用进程" FontWeight="Bold" Margin="0,0,0,4" />
                    <ListBox x:Name="ProcessListBox" MinHeight="80" Foreground="White" Background="Transparent" />
                </StackPanel>
            </ui:Card.Content>
        </ui:Card>

        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button Content="确定" Appearance="Primary" Foreground="White" IsDefault="True" Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
