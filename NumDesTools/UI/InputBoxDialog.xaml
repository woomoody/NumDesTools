<ui:FluentWindow
    x:Class="NumDesTools.UI.InputBoxDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="输入"
    SizeToContent="WidthAndHeight"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown">
    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="输入" />
        <StackPanel Grid.Row="1">
            <ui:TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="13" />
            <ui:TextBox x:Name="InputBox" MinWidth="320" Margin="0,10,0,0" />
            <ui:Button
                HorizontalAlignment="Right"
                IsDefault="True"
                Appearance="Primary"
                Margin="0,10,0,0"
                Click="OkButton_Click"
                Content="确定" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
