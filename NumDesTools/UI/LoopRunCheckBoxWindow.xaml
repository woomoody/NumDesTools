<ui:FluentWindow
    x:Class="NumDesTools.UI.LoopRunCheckBoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="计算选项"
    Width="500"
    Height="500"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_EscClose">
    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="计算选项" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Name="SpecialCheckBoxContainer" Margin="5">
                    <CheckBox
                        Margin="5"
                        Foreground="White"
                        Checked="SelectAllCheckBox_Checked"
                        Content="全选/取消"
                        Tag="全选"
                        Unchecked="SelectAllCheckBox_Unchecked" />
                    <CheckBox
                        Margin="5"
                        Foreground="White"
                        Checked="InvertSelectionCheckBox_Checked"
                        Content="反选"
                        Tag="反选" />
                </StackPanel>
                <Separator Margin="5" />
                <StackPanel Name="CheckBoxContainer" Margin="5" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="2"
            Margin="5"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Width="100"
                Height="30"
                Margin="5"
                Appearance="Primary"
                Click="GetCurrentCheckBox_Click"
                Content="计算随机数" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
