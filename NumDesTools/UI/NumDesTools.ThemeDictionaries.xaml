<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         NumDesTools 语义色 — 深浅双套
         
         设计原则：
         - 色值（Color）在 C# 代码中按主题切换时更新（MahAppsHelper.ApplySemanticBrushes）
         - 画刷（SolidColorBrush）在 XAML 中定义，通过 DynamicResource 引用色值
         - 主题切换时只需更新 Color 值，Brush 不变，零 GC 压力
         - 改色只需改 XAML 色值或 MahAppsHelper 中的 hex 字面量
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── 默认色值（深色主题，初始化时加载；主题切换时由代码更新） ── -->
    <Color x:Key="OursTextColor">#FFAAAA</Color>
    <Color x:Key="OursBgColor">#3A2A2A</Color>
    <Color x:Key="OursActionBgColor">#5A2A2A</Color>
    <Color x:Key="TheirsTextColor">#A8FFCA</Color>
    <Color x:Key="TheirsBgColor">#1A5C3A</Color>
    <Color x:Key="ConflictTextColor">#AAAAFF</Color>
    <Color x:Key="ConflictBgColor">#3A3A5A</Color>
    <Color x:Key="HistoryTextColor">#88CCFF</Color>
    <Color x:Key="HistoryBgColor">#1A3A6E</Color>
    <Color x:Key="AiSuggestionTextColor">#FFD080</Color>
    <Color x:Key="AiSuggestionBgColor">#2A2A1A</Color>
    <Color x:Key="AiSuggestionBorderColor">#554400</Color>
    <Color x:Key="SemanticButtonTextColor">Black</Color>

    <!-- ── 画刷（通过 DynamicResource 引用色值，主题切换时自动更新） ── -->
    <SolidColorBrush x:Key="OursTextBrush"
                     Color="{DynamicResource OursTextColor}" />
    <SolidColorBrush x:Key="OursBackgroundBrush"
                     Color="{DynamicResource OursBgColor}" />
    <SolidColorBrush x:Key="OursActionBackgroundBrush"
                     Color="{DynamicResource OursActionBgColor}" />
    <SolidColorBrush x:Key="TheirsTextBrush"
                     Color="{DynamicResource TheirsTextColor}" />
    <SolidColorBrush x:Key="TheirsBackgroundBrush"
                     Color="{DynamicResource TheirsBgColor}" />
    <SolidColorBrush x:Key="ConflictTextBrush"
                     Color="{DynamicResource ConflictTextColor}" />
    <SolidColorBrush x:Key="ConflictBackgroundBrush"
                     Color="{DynamicResource ConflictBgColor}" />
    <SolidColorBrush x:Key="HistoryTextBrush"
                     Color="{DynamicResource HistoryTextColor}" />
    <SolidColorBrush x:Key="HistoryBackgroundBrush"
                     Color="{DynamicResource HistoryBgColor}" />
    <SolidColorBrush x:Key="AiSuggestionTextBrush"
                     Color="{DynamicResource AiSuggestionTextColor}" />
    <SolidColorBrush x:Key="AiSuggestionBackgroundBrush"
                     Color="{DynamicResource AiSuggestionBgColor}" />
    <SolidColorBrush x:Key="AiSuggestionBorderBrush"
                     Color="{DynamicResource AiSuggestionBorderColor}" />
    <SolidColorBrush x:Key="SemanticButtonTextBrush"
                     Color="{DynamicResource SemanticButtonTextColor}" />
</ResourceDictionary>