<ui:FluentWindow
    x:Class="NumDesTools.UI.GitExportSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Git 变更导出 — 选择文件"
    Width="680" Height="580" MinWidth="500" MinHeight="400"
    WindowStartupLocation="CenterScreen"
    KeyDown="Window_EscClose"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Git 变更导出 — 选择文件" />

        <!-- 模式选择区 -->
        <Border Grid.Row="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4" Padding="12,10">
            <StackPanel>
                <ui:TextBlock Text="导出范围"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <RadioButton x:Name="ModeGitStaged" Content="Git 变更 + 暂存区"
                             GroupName="ExportMode" IsChecked="True" Checked="Mode_Changed"/>

                <RadioButton x:Name="ModeWithHistory" Content="Git 变更 + 暂存区 + 近期提交"
                             GroupName="ExportMode" Margin="0,6,0,0" Checked="Mode_Changed"/>
                <StackPanel x:Name="HistoryAuthorRow" IsEnabled="False" Margin="22,3,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="作者："
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="10" VerticalAlignment="Center"/>
                        <ui:TextBlock x:Name="AuthorText"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="HistoryPanel" IsEnabled="False" Orientation="Horizontal"
                            Margin="22,4,0,0">
                    <ui:TextBlock Text="最近"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="−" Width="22" Height="22" Padding="0"
                                    Click="DecCommitCount_Click"/>
                            <ui:TextBlock x:Name="CommitCountText" Text="3"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontSize="12" Width="28"
                                       TextAlignment="Center" VerticalAlignment="Center"/>
                            <ui:Button Content="+" Width="22" Height="22" Padding="0"
                                    Click="IncCommitCount_Click"/>
                        </StackPanel>
                    </Border>
                    <ui:TextBlock Text="次我的提交"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <ui:Button Content="刷新" Margin="10,0,0,0" Padding="8,2"
                            Click="Refresh_Click"/>
                </StackPanel>

                <!-- 指定提交模式 -->
                <RadioButton x:Name="ModeSpecificCommit" Content="指定某次提交"
                             GroupName="ExportMode" Margin="0,6,0,0" Checked="Mode_Changed"/>
                <StackPanel x:Name="CommitPickPanel" IsEnabled="False" Margin="22,6,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:TextBlock Text="选择提交："
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:Button Content="加载列表" Padding="8,2"
                                Click="LoadCommitList_Click"/>
                        <ui:TextBlock Text="作者：" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="16,0,4,0"/>
                        <ComboBox x:Name="CommitAuthorBox" Width="140"
                                  FontFamily="Consolas" FontSize="11"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  SelectionChanged="CommitAuthorBox_SelectionChanged"/>
                    </StackPanel>
                    <ComboBox x:Name="CommitCombo"
                              MaxWidth="560" HorizontalAlignment="Left"
                              FontFamily="Consolas" FontSize="11"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              SelectionChanged="CommitCombo_SelectionChanged"
                              DisplayMemberPath="Display"/>
                </StackPanel>

                <!-- 全表导出模式 -->
                <RadioButton x:Name="ModeFullExport" Content="全表导出（清空 Tables 后重新导 Localizations/Tables/UIs 全部）"
                             GroupName="ExportMode" Margin="0,6,0,0" Checked="Mode_Changed"/>
            </StackPanel>
        </Border>

        <Separator Grid.Row="2" Margin="0,8"/>

        <!-- 全选行 + 文件数统计 -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SelectAllBox" Grid.Column="0" Content="全选 / 取消全选"
                      Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"/>
            <ui:TextBlock x:Name="FileCountText" Grid.Column="1"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- 文件列表 -->
        <Border Grid.Row="4"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FileListPanel" Margin="4"/>
            </ScrollViewer>
        </Border>

        <!-- 底部 -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBlock x:Name="StatusText" Grid.Column="0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="取消" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <ui:Button Content="导出选中文件"
                        Click="Export_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
