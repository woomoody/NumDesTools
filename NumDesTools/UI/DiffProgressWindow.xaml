<ui:FluentWindow
    x:Class="NumDesTools.UI.DiffProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="正在解析差异…"
    Width="320" Height="100"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    
    
    
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="正在解析差异…" />
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                              Foreground="#4FC3F7"
                              HorizontalAlignment="Center"/>
            <ui:TextBlock x:Name="MsgText" Text="正在比较文件，请稍候…"
                       Foreground="Gray"
                       FontSize="12" Margin="0,10,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
