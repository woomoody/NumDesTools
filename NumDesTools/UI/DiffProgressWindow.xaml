<ui:FluentWindow
    x:Class="NumDesTools.UI.DiffProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title=""
    Width="280" Height="72"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="None"
    Background="Transparent"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Border CornerRadius="8" Padding="20,14">
        <Border.Background>
                <DynamicResource ResourceKey="ControlFillColorSecondaryBrush"/>
        </Border.Background>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                              VerticalAlignment="Center"/>
            <ui:TextBlock x:Name="MsgText" Text="正在比较文件，请稍候…"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       FontSize="12" Margin="14,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</ui:FluentWindow>
